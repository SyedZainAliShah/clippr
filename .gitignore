# Environments and caches
.venv/
# Throwaway environment for validation/notebook_on_published_build.py
.sim/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Regenerable caches. The .npz are parsed from the .xlsx in data/matrices, which ARE
# tracked -- the package cannot score ligation fidelity without them.
src/ppropt/data/matrices/*.npz
data/codon_tables/

# Publisher supplementary material (6.1 MB). Ours to read and analyse, not ours to
# redistribute. Download it from the paper's supplementary files if you need it.
data/grasp_supp/

# The 200-design validation corpus (38 MB). Not tracked for two reasons: its size, and
# it is third-party program output rather than anything this repository authored. The
# validation scripts that read it are kept, and they fail with a clear message when the
# corpus is absent.
results/

# Notebook and scratch output. `ppropt_library/` is what the notebook's library cell writes
# when run from the repository root, which is exactly what happens when the notebook is
# executed as a test.
notebooks/ppropt_output/
ppropt_output/
ppropt_library/
# Left over from before the rename to ppropt. Renaming the patterns above stopped
# ignoring these, and a sweeping `git add` committed them once; keep them out.
notebooks/clippr_output/
clippr_output/
clippr_library/
out/
our_cds.json
*.ipynb_checkpoints/
CLAUDE.md

# Local-only validation. These depend on an external oracle that not every checkout has;
# they stay on disk and keep working here, but are not part of the distributed repository.
# Keep them — they are the record of how this package was verified.
validation/compare_ppr.py
validation/sweep_reference.py
tests/test_no_reference_import.py

# Fetched genomes, cached on first use
data/genomes/

# Experiment outputs. Regenerated by the scripts in validation/; not distributed.
work/

# Stray experiment outputs that have landed in the repo root. exp_a_seqs.pkl is 215 MB;
# GitHub rejects anything over 100 MB, so an accidental `git add -A` would wedge the push.
exp_a_*.pkl
exp_a_*.json

# Supplementary Table S1, staged at the repo root by validation/run_notebook.py so the
# inventory cells run against a real input. It is not ours to distribute -- see NOTICE.md.
# The harness removes it on a clean exit; a killed run leaves it behind.
/Table S1.xlsx
